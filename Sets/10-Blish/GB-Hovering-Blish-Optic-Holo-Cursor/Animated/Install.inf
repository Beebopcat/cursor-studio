; GW2 - Blish (Golemite) - GB Hovering Blish Optic & Holo-Cursor (Animated) - Windows 11 cursor scheme. Right-click this file > Install.
; (Installs to C:\Windows\Cursors and needs administrator approval. The Cursor Studio app does not.)
[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%arrow%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%appstarting%,%10%\%CUR_DIR%\%wait%,%10%\%CUR_DIR%\%crosshair%,%10%\%CUR_DIR%\%ibeam%,%10%\%CUR_DIR%\%nwpen%,%10%\%CUR_DIR%\%no%,%10%\%CUR_DIR%\%sizens%,%10%\%CUR_DIR%\%sizewe%,%10%\%CUR_DIR%\%sizenwse%,%10%\%CUR_DIR%\%sizenesw%,%10%\%CUR_DIR%\%sizeall%,%10%\%CUR_DIR%\%uparrow%,%10%\%CUR_DIR%\%hand%,%10%\%CUR_DIR%\%pin%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
01-NormalSelect.ani
02-HelpSelect.ani
03-WorkingInBackground.ani
04-Busy.ani
05-PrecisionSelect.ani
06-TextSelect.ani
07-Handwriting.ani
08-Unavailable.ani
09-VerticalResize.ani
10-HorizontalResize.ani
11-DiagonalResize1.ani
12-DiagonalResize2.ani
13-Move.ani
14-AlternateSelect.ani
15-LinkSelect.ani
16-LocationSelect.ani
17-PersonSelect.ani

[Strings]
CUR_DIR = "Cursors\GW2 - Blish (Golemite) - GB Hovering Blish Optic & Holo-Cursor (Animated)"
SCHEME_NAME = "GW2 - Blish (Golemite) - GB Hovering Blish Optic & Holo-Cursor (Animated)"
arrow = "01-NormalSelect.ani"
help = "02-HelpSelect.ani"
appstarting = "03-WorkingInBackground.ani"
wait = "04-Busy.ani"
crosshair = "05-PrecisionSelect.ani"
ibeam = "06-TextSelect.ani"
nwpen = "07-Handwriting.ani"
no = "08-Unavailable.ani"
sizens = "09-VerticalResize.ani"
sizewe = "10-HorizontalResize.ani"
sizenwse = "11-DiagonalResize1.ani"
sizenesw = "12-DiagonalResize2.ani"
sizeall = "13-Move.ani"
uparrow = "14-AlternateSelect.ani"
hand = "15-LinkSelect.ani"
pin = "16-LocationSelect.ani"
person = "17-PersonSelect.ani"
